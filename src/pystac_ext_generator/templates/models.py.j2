def _encode(value: Any) -> Any:
    """Convert generated objects at any depth into plain JSON containers."""
{% if models %}
    if isinstance(value, _Object):
        value = value.properties
{% endif %}
    if isinstance(value, dict):
        return {key: _encode(child) for key, child in value.items()}
    if isinstance(value, (list, tuple)):
        return [_encode(child) for child in value]
    return value


{% if codec_kinds %}
def _decode(value: Any, codec: Any) -> Any:
    """Wrap schema-declared objects while retaining live backing dictionaries."""
    if value is None or codec is None:
        return value
    kind, detail = codec
{% if 'object' in codec_kinds %}
    if kind == "object":
        return _MODELS[detail].from_dict(value)
{% endif %}
{% if 'list' in codec_kinds %}
    if kind == "list":
        return _decode_list(value, detail)
{% endif %}
{% if 'map' in codec_kinds %}
    if kind == "map":
        return _decode_map(value, detail)
{% endif %}
{% if 'union' in codec_kinds %}
    if kind == "union":
        return _decode_union(value, detail)
{% endif %}
    raise ValueError(f"Unknown conversion: {kind}")

{% if 'list' in codec_kinds %}
def _decode_list(value: Any, codec: Any) -> list[Any]:
    """Decode the elements of a schema-declared array."""
    if not isinstance(value, list):
        raise TypeError("Expected a JSON array")
    return [_decode(child, codec) for child in value]
{% endif %}

{% if 'map' in codec_kinds %}
def _decode_map(value: Any, codec: Any) -> dict[str, Any]:
    """Decode the values of a schema-declared object map."""
    if not isinstance(value, dict):
        raise TypeError("Expected a JSON object map")
    return {key: _decode(child, codec) for key, child in value.items()}
{% endif %}

{% if 'union' in codec_kinds %}
@lru_cache(maxsize=128)
def _union_validator(branch_json: str) -> Validator:
    """Validate a resolved branch with its own root for recursive references."""
    return validator_for(SCHEMA)(json.loads(branch_json))


def _decode_union(value: Any, branches: list[Any]) -> Any:
    """Decode only when matching union branches agree on one representation."""
    matches = []
    for branch_json, branch_codec in branches:
        if _union_validator(branch_json).is_valid(value) and branch_codec not in matches:
            matches.append(branch_codec)
    if len(matches) != 1:
        raise ValueError("Nested union has no unique representation; validate the JSON or access raw properties")
    return _decode(value, matches[0])
{% endif %}
{% endif %}

